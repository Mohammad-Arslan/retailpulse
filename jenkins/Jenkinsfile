// =============================================================================
// RetailPulse — Jenkins Declarative Pipeline (CI/CD source of truth)
//
// Intended controller: retailpulse-jenkins (see docker-compose.ops.yml).
// Agent: built-in (same image has Docker CLI, Composer, Node, npm, Python3, Git).
//
// Auto-trigger: `triggers { pollSCM }` below — Jenkins polls this job's configured
// SCM (main) every 2 minutes and builds+deploys on new commits. No inbound webhook
// is needed (Jenkins stays 127.0.0.1-only; see docs/ops-stack.md §2.1/§4).
// This requires the job itself to be created once as "Pipeline script from SCM"
// pointed at this file — see docs/ops-stack.md §4.
//
// Email notifications: sent via docker/jenkins/scripts/send-mail.py, a small
// reusable script whose SMTP transport (host/port/TLS/auth) is entirely env-driven
// (JENKINS_SMTP_*, set on the jenkins container in docker-compose.ops.yml / .env).
// Moving from Mailpit to a real SMTP provider later is a `.env` change only --
// this Jenkinsfile and the script never need to change.
//
// Credentials (configure in Jenkins → Manage Jenkins → Credentials):
//   retailpulse-git          — GitHub PAT (HTTPS) or SSH key for Mohammad-Arslan/retailpulse
//   retailpulse-vps-ssh      — SSH private key for the Contabo VPS (deploy)
//
// Default repo: https://github.com/Mohammad-Arslan/retailpulse.git
// =============================================================================

def sendBuildNotification(String status) {
    def bodyFile = 'notification-body.txt'
    def lines = []
    lines << "RetailPulse Jenkins pipeline -- ${status}"
    lines << "Job: ${env.JOB_NAME}  Build: #${env.BUILD_NUMBER}"
    lines << "Branch: ${params.GIT_BRANCH}  Commit: ${env.GIT_COMMIT_SHORT ?: 'n/a'}"
    lines << "Deploy requested: ${params.DEPLOY_PRODUCTION}"
    lines << "Details: ${env.BUILD_URL}"
    lines << ''
    lines << (status == 'SUCCESS'
        ? 'Release notes since the last successful deploy are attached.'
        : 'See the console log (link above) for the failing stage.')
    writeFile file: bodyFile, text: lines.join('\n')

    def attachments = []
    if (status == 'SUCCESS' && fileExists(env.RELEASE_NOTES_FILE)) {
        attachments << env.RELEASE_NOTES_FILE
    }

    def recipients = env.NOTIFY_EMAIL?.trim()
    if (!recipients) {
        echo '[notify] NOTIFY_EMAIL is not set — skipping email notification.'
        return
    }

    def attachArgs = attachments.collect { "--attach '${it}'" }.join(' ')
    sh """
        set -euo pipefail
        python3 docker/jenkins/scripts/send-mail.py \\
          --to '${recipients}' \\
          --subject 'RetailPulse Jenkins ${status} - build #${env.BUILD_NUMBER} (${env.GIT_COMMIT_SHORT ?: 'n/a'})' \\
          --body-file ${bodyFile} \\
          ${attachArgs}
    """
}

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 90, unit: 'MINUTES')
    }

    triggers {
        // Polling, not a webhook: Jenkins stays 127.0.0.1-only (no inbound
        // exposure needed) and only needs outbound internet, which it already
        // has for git/composer/npm. ~2 minute worst-case trigger latency.
        pollSCM('H/2 * * * *')
    }

    parameters {
        string(name: 'GIT_URL', defaultValue: 'https://github.com/Mohammad-Arslan/retailpulse.git', description: 'Repository URL')
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'Branch to build (push feature/ops-observability-stack before selecting it)')
        booleanParam(name: 'RUN_PINT', defaultValue: true, description: 'Run Laravel Pint')
        booleanParam(name: 'RUN_PHPUNIT', defaultValue: false, description: 'Run PHPUnit/Pest suite (often skipped until suite is green)')
        booleanParam(name: 'BUILD_IMAGE', defaultValue: true, description: 'Build retailpulse-app:production')
        booleanParam(name: 'DEPLOY_PRODUCTION', defaultValue: true, description: 'SSH to VPS and run setup.sh production --rebuild. Defaults on: auto-triggered builds on main are meant to deploy. Uncheck via "Build with Parameters" for a build-only dry run.')
        string(name: 'VPS_HOST', defaultValue: '169.58.58.151', description: 'VPS hostname/IP (required when DEPLOY_PRODUCTION)')
        string(name: 'VPS_USER', defaultValue: 'ubuntu', description: 'SSH user on the VPS')
        string(name: 'VPS_APP_DIR', defaultValue: '/var/www/retailpulse', description: 'App path on the VPS')
    }

    environment {
        COMPOSER_ALLOW_SUPERUSER = '1'
        PHP_VERSION_HINT = '8.3'
        NODE_VERSION_HINT = '20'
        APP_IMAGE = 'retailpulse-app:production'
        // Match Dockerfile / CI: lock has a PHP 8.4.1 platform constraint on one
        // transitive package while the project runs PHP 8.3 everywhere.
        COMPOSER_FLAGS = '--no-interaction --prefer-dist --ignore-platform-reqs'
        // Persisted in the jenkins_home volume (NOT the workspace, which cleanWs()
        // wipes every build) so release notes can diff against the last deploy.
        LAST_DEPLOYED_SHA_FILE = '/var/jenkins_home/state/retailpulse-last-deployed-sha.txt'
        RELEASE_NOTES_FILE = 'release-notes.txt'
        // Set on the jenkins container (docker-compose.ops.yml / .env): JENKINS_NOTIFY_EMAIL
        NOTIFY_EMAIL = "${env.JENKINS_NOTIFY_EMAIL ?: ''}"
    }

    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${params.GIT_BRANCH}"]],
                    // Full history (no shallow/depth limit) -- the Release notes
                    // stage below needs `git log <previous-deployed-sha>..HEAD`,
                    // which a shallow clone can't resolve.
                    extensions: [[$class: 'CloneOption', shallow: false, noTags: false]],
                    userRemoteConfigs: [[
                        url: params.GIT_URL
                    ]]
                ])
                sh 'git rev-parse --short HEAD > .git-commit'
                script {
                    env.GIT_COMMIT_SHORT = readFile('.git-commit').trim()
                }
            }
        }

        stage('Release notes') {
            steps {
                script {
                    sh "mkdir -p \$(dirname ${env.LAST_DEPLOYED_SHA_FILE})"
                    def previousSha = fileExists(env.LAST_DEPLOYED_SHA_FILE) ? readFile(env.LAST_DEPLOYED_SHA_FILE).trim() : ''
                    def notes = sh(
                        script: previousSha
                            ? "git log ${previousSha}..HEAD --no-merges --date=short --pretty=format:'- %s (%h) - %an, %ad' || true"
                            : "git log -n 20 --no-merges --date=short --pretty=format:'- %s (%h) - %an, %ad' || true",
                        returnStdout: true
                    ).trim()
                    if (!notes) {
                        notes = 'No new commits since the last successful deploy.'
                    }
                    def generatedAt = sh(script: 'date -u +%Y-%m-%dT%H:%M:%SZ', returnStdout: true).trim()
                    writeFile file: env.RELEASE_NOTES_FILE, text: """RetailPulse release notes
Build: #${env.BUILD_NUMBER}
Commit: ${env.GIT_COMMIT_SHORT}
Branch: ${params.GIT_BRANCH}
Generated: ${generatedAt}
Previous deployed commit: ${previousSha ?: 'unknown (first tracked deploy)'}

Changes:
${notes}
"""
                }
            }
        }

        stage('Composer install') {
            steps {
                sh """
                    set -euo pipefail
                    composer install ${COMPOSER_FLAGS}
                """
            }
        }

        stage('npm install') {
            steps {
                sh '''
                    set -euo pipefail
                    npm ci
                '''
            }
        }

        stage('Pint') {
            when {
                expression { return params.RUN_PINT }
            }
            steps {
                sh '''
                    set -euo pipefail
                    ./vendor/bin/pint --test
                '''
            }
        }

        stage('PHPUnit') {
            when {
                expression { return params.RUN_PHPUNIT }
            }
            steps {
                sh '''
                    set -euo pipefail
                    cp -n .env.example .env || true
                    php artisan key:generate --no-interaction || true
                    npm run build
                    composer test
                '''
            }
        }

        stage('Build Docker image') {
            when {
                expression { return params.BUILD_IMAGE }
            }
            steps {
                sh """
                    set -euo pipefail
                    docker build \\
                      --target production \\
                      --build-arg BUILDKIT_INLINE_CACHE=1 \\
                      -t ${APP_IMAGE} \\
                      -t retailpulse-app:${env.GIT_COMMIT_SHORT} \\
                      .
                """
            }
        }

        stage('Deploy (setup.sh production --rebuild)') {
            when {
                allOf {
                    expression { return params.DEPLOY_PRODUCTION }
                    expression { return params.VPS_HOST?.trim() }
                }
            }
            steps {
                sshagent(credentials: ['retailpulse-vps-ssh']) {
                    sh """
                        set -euo pipefail
                        ssh -o StrictHostKeyChecking=accept-new \\
                            ${params.VPS_USER}@${params.VPS_HOST} \\
                            'set -euo pipefail
                             cd ${params.VPS_APP_DIR}
                             git fetch origin
                             git checkout ${params.GIT_BRANCH}
                             git pull --ff-only origin ${params.GIT_BRANCH}
                             bash setup.sh production --rebuild'
                    """
                }
            }
        }

        stage('Optimize & verify health') {
            when {
                expression { return params.DEPLOY_PRODUCTION && params.VPS_HOST?.trim() }
            }
            steps {
                sshagent(credentials: ['retailpulse-vps-ssh']) {
                    sh """
                        set -euo pipefail
                        ssh -o StrictHostKeyChecking=accept-new \\
                            ${params.VPS_USER}@${params.VPS_HOST} \\
                            'set -euo pipefail
                             cd ${params.VPS_APP_DIR}
                             # Entrypoint already caches on boot; re-warm after deploy settles.
                             sleep 20
                             docker compose exec -T app php artisan optimize || true
                             docker compose exec -T app php artisan config:cache
                             docker compose exec -T app php artisan route:cache
                             docker compose exec -T app php artisan view:cache
                             curl -fsS -o /dev/null -w "%{http_code}" http://127.0.0.1:8000/up | grep -E "200|204"
                             docker compose ps
                             docker compose exec -T app php artisan horizon:status || true'
                    """
                }
                // Health check above already failed the stage (non-2xx) before this
                // point, so reaching here means the deploy is confirmed live.
                sh "echo ${env.GIT_COMMIT_SHORT} > ${env.LAST_DEPLOYED_SHA_FILE}"
            }
        }
    }

    post {
        success {
            echo "RetailPulse pipeline OK — commit ${env.GIT_COMMIT_SHORT}"
            sendBuildNotification('SUCCESS')
        }
        failure {
            echo "RetailPulse pipeline FAILED — commit ${env.GIT_COMMIT_SHORT}"
            sendBuildNotification('FAILURE')
        }
        always {
            cleanWs(cleanWhenNotBuilt: false, deleteDirs: true, disableDeferredWipeout: true)
        }
    }
}
